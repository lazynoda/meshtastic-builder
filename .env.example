MB_BASE_URL=http://localhost:8080
MB_HOST=127.0.0.1
MB_PORT=8080

# Set to 1 only behind a reverse proxy that is the sole route to this app,
# otherwise clients can spoof X-Forwarded-For and bypass rate limiting.
MB_TRUST_PROXY=0
MB_DATA_DIR=./var
MB_DB_PATH=./var/meshtastic-builder.sqlite
MB_ARTIFACT_DIR=./var/artifacts
MB_BUILDER_IMAGE=meshtastic-firmware-builder:local
MB_DOCKER_NETWORK=bridge
MB_DOCKER_TRANSPORT=auto
MB_BUILD_TIMEOUT_SECONDS=3600
MB_ARTIFACT_TTL_DAYS=7
MB_GITHUB_MAX_TAG_PAGES=20
MB_AUTO_SUPPORT_LATEST_TAGS=20

# Local development only. Set to fake to exercise the full queue without Docker.
MB_BUILDER_MODE=docker
