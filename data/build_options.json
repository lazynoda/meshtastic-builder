{
  "minFirmwareVersion": "2.6.4",
  "nativeSinceFirmwareVersion": "2.8.0",
  "eightChannelsSinceFirmwareVersion": "2.8.0",
  "patchFile": "docker/patches/userprefs-ext.patch",
  "fixedGpsPatch": {
    "patchFile": "docker/patches/fixed-gps-nodedb.patch",
    "triggerMacro": "USERPREFS_FIXED_GPS",
    "minFirmwareVersion": "2.8.0",
    "fixedSinceFirmwareVersion": "2.8.1",
    "upstreamPullRequest": "https://github.com/meshtastic/firmware/pull/11825"
  },
  "okToMqtt": {
    "macro": "USERPREFS_CONFIG_LORA_OK_TO_MQTT",
    "nativeMacro": "USERPREFS_CONFIG_LORA_CONFIG_OK_TO_MQTT",
    "default": true
  },
  "customLora": {
    "usePresetMacro": "USERPREFS_LORACONFIG_USE_PRESET",
    "fields": {
      "bandwidthKhz": {
        "macro": "USERPREFS_LORACONFIG_BANDWIDTH",
        "choices": [
          31,
          62,
          125,
          250,
          500
        ],
        "default": 62
      },
      "spreadFactor": {
        "macro": "USERPREFS_LORACONFIG_SPREAD_FACTOR",
        "min": 5,
        "max": 12,
        "default": 7
      },
      "codingRate": {
        "macro": "USERPREFS_LORACONFIG_CODING_RATE",
        "min": 5,
        "max": 8,
        "default": 5
      },
      "channelNum": {
        "macro": "USERPREFS_LORACONFIG_CHANNEL_NUM",
        "min": 0,
        "max": 255,
        "default": 4
      },
      "overrideFrequencyMhz": {
        "macro": "USERPREFS_LORACONFIG_OVERRIDE_FREQUENCY",
        "type": "float",
        "min": 0,
        "max": 1000,
        "step": 0.001,
        "default": 869.618
      }
    }
  }
}
